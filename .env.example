MAIN_ACCOUNT_USERNAME=your_main_username
MAIN_ACCOUNT_PASSWORD=your_main_password
BOT_ACCOUNT_USERNAME=your_bot_username
BOT_ACCOUNT_PASSWORD=your_bot_password
SESSION_ENCRYPTION_KEY=your_fernet_32byte_base64_key
GEMINI_API_KEY=your_gemini_api_key
DB_PATH=./data/app.db
CHROMA_PATH=./data/chroma
POLL_INTERVAL_SECONDS=15

# 模型配置（可自訂優先順序，以逗號分隔）
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_CANDIDATE_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite

# 日誌路徑
LLM_LOG_PATH=./logs/llm.log
