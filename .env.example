# ==============================================================================
# 1. 必填：IG 帳號密碼與 API 金鑰
# ==============================================================================
MAIN_ACCOUNT_USERNAME=your_main_username
MAIN_ACCOUNT_PASSWORD=your_main_password
BOT_ACCOUNT_USERNAME=your_bot_username
BOT_ACCOUNT_PASSWORD=your_bot_password
GEMINI_API_KEY=your_gemini_api_key

# ==============================================================================
# 2. 安全性與鑑權設定（可選）
# ==============================================================================
# 主帳號 Instagram User ID (PK)；若未設定則啟動時自動透過 API 解析
MAIN_ACCOUNT_USER_ID=
# Session 加密金鑰 (Fernet 32-byte base64)；若未設定則自動保存至 data/.session_key 持久化
SESSION_ENCRYPTION_KEY=

# ==============================================================================
# 3. 模型與日誌設定
# ==============================================================================
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_CANDIDATE_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash
GEMINI_FULL_SUMMARY_MODEL=gemini-3.5-flash-lite
# 是否啟用 LLM 呼叫明文記錄（預設開啟，方便個人 debug 追蹤）
ENABLE_LLM_LOG=true
LLM_LOG_PATH=./logs/llm.log

# ==============================================================================
# 4. 記憶與 RAG 檢索調優參數
# ==============================================================================
# 組裝提示詞時，載入與目前對象在 IG 上的近期原始對話則數
RECENT_MESSAGES_LIMIT=20
# 與 AI 討論時，納入提示詞的本輪對話歷史輪數
CHAT_HISTORY_TURNS=10
# 對象歷史對話向量庫 (chat_chunks) 的語意檢索筆數
CONTACT_RAG_RESULTS=5
# 使用者自身記憶向量庫 (user_self) 的語意檢索筆數
SELF_RAG_RESULTS=3
# 對話中提及其他聯絡人暱稱時，跨對象向量檢索筆數
CROSS_RAG_RESULTS=3

# ==============================================================================
# 5. 抓取、切塊與摘要更新門檻
# ==============================================================================
# track_full 安全慢速全量抓取時的預設最大歷史訊息則數
TRACK_FULL_DEFAULT_LIMIT=5000
# 歷史對話切塊（Chunking）時，單一 Chunk 容納的最多訊息筆數
CHUNK_MAX_SIZE=20
# 累積新訊息達此數量時，觸發自動更新人物關係摘要卡
SUMMARY_MESSAGE_THRESHOLD=50
# 摘要卡超過此天數未更新且有新訊息時，觸發自動更新
SUMMARY_DAYS_LIMIT=14
# Bot 私訊輪詢間隔（秒）
POLL_INTERVAL_SECONDS=15

# ==============================================================================
# 6. 本地儲存路徑
# ==============================================================================
DB_PATH=./data/app.db
CHROMA_PATH=./data/chroma
SESSION_DIR=./data/sessions
LOG_DIR=./logs



